# Copy to .env before running docker compose. CHANGE these before putting the site on a public server.
DB_PASSWORD=choose-a-strong-password
JWT_SECRET=use-a-long-random-string-of-at-least-32-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-admin-password
CORS_ORIGIN=http://localhost
# Your public web address, used in the unsubscribe link of newsletter emails
PUBLIC_URL=http://localhost
# true = the forgot-password code is shown on screen. Only for testing on your own computer, never online.
EXPOSE_RESET_CODE=false
# Optional: Razorpay TEST keys (leave blank to use the built-in dummy payment window)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
